# AutoKeeper Environment Variables
# Copy this file to .env and update with your values

# Backend API Configuration
# Development: http://localhost:3000
# Production: https://api.autokeeper.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: Different URLs for different environments
# EXPO_PUBLIC_API_URL_DEV=http://localhost:3000
# EXPO_PUBLIC_API_URL_STAGING=https://staging-api.autokeeper.com
# EXPO_PUBLIC_API_URL_PROD=https://api.autokeeper.com
